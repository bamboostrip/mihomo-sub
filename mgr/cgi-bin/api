#!/bin/sh

# CGI API - Mihomo 订阅管理后端

CONFIG_DIR="/root/.config/mihomo"
SUB_URLS_FILE="${CONFIG_DIR}/sub_urls.txt"
SCHEDULE_FILE="${CONFIG_DIR}/schedule.conf"
GROUP_MODE_FILE="${CONFIG_DIR}/group_mode.conf"
LOG_FILE="${CONFIG_DIR}/log.txt"
SUB_SCRIPT="/etc/periodic/15min/sub.sh"
# 订阅行分隔符：别名<TAB>URL（TAB 不可能出现在 URL 里）
TAB=$(printf '\t')

# 取某行的 URL 部分（兼容无别名的老格式；第三列 off 为停用标记）
url_part() {
    case "$1" in
        *"${TAB}"*) printf '%s' "$1" | cut -f2 ;;
        *) printf '%s' "$1" ;;
    esac
}

# 取某行的别名部分（无 TAB 即无别名）
alias_part() {
    case "$1" in
        *"${TAB}"*) printf '%s' "$1" | cut -f1 ;;
        *) printf '' ;;
    esac
}

# 取某行的状态（第三列 off=停用）
state_part() {
    case "$1" in
        *"${TAB}"*) printf '%s' "$1" | cut -f3 ;;
        *) printf '' ;;
    esac
}

# 组装一行：别名<TAB>URL[<TAB>off]；无别名时 on 保持纯 URL 老格式
emit_line() {
    # $1=alias $2=url $3=on|off
    if [ -n "$1" ]; then
        if [ "$3" = "off" ]; then printf '%s\t%s\toff\n' "$1" "$2"; else printf '%s\t%s\n' "$1" "$2"; fi
    else
        if [ "$3" = "off" ]; then printf '\t%s\toff\n' "$2"; else printf '%s\n' "$2"; fi
    fi
}

# TUN 可用性检查：/dev/net/tun 存在 + 容器持有 NET_ADMIN（CapEff bit12 = 0x1000）
tun_prereq() {
    [ -e /dev/net/tun ] || return 1
    cap=$(awk '/^CapEff:/{print $2}' /proc/self/status 2>/dev/null)
    [ -n "${cap}" ] || return 1
    [ $(( 0x${cap} & 4096 )) -ne 0 ] || return 1
    return 0
}

# 本机 mihomo API 请求：绕开代理变量，避免经自身代理打回环
api_curl() {
    env -u http_proxy -u https_proxy -u HTTP_PROXY -u HTTPS_PROXY -u all_proxy -u ALL_PROXY \
        curl -s "$@"
}

# 注释判断：行首 # 且不含 TAB 才算注释（含 TAB 是“别名以 # 开头”的订阅行）
is_comment() {
    case "$1" in
        "#"*)
            case "$1" in
                *"${TAB}"*) return 1 ;;
                *) return 0 ;;
            esac
            ;;
        *) return 1 ;;
    esac
}

# 输出 JSON 响应头
json_header() {
    printf "Content-Type: application/json; charset=utf-8\r\n\r\n"
}

# 读取 POST body
read_body() {
    if [ "${REQUEST_METHOD}" = "POST" ]; then
        dd bs=1 count="${CONTENT_LENGTH}" 2>/dev/null
    fi
}

# sub_urls.txt 读改写锁：并发 CGI 请求串行化，避免后写者覆盖丢更新
# busybox flock 支持 fd 加锁，锁持有到进程退出；busybox flock 没有 -w 超时参数
# （实测 1.36/1.37 均无），改用 -n 非阻塞 + 100ms 轮询重试，最多等 5 秒，抢不到按失败处理
URLS_LOCK="/tmp/mihomo_urls.lock"
urls_lock() {
    command -v flock >/dev/null 2>&1 || return 0
    exec 9>"${URLS_LOCK}"
    lock_wait=0
    while ! flock -n 9; do
        lock_wait=$((lock_wait + 1))
        [ "${lock_wait}" -ge 50 ] && return 1
        sleep 0.1
    done
    return 0
}

# 获取 action 参数
action=$(echo "${QUERY_STRING}" | sed -n 's/.*action=\([^&]*\).*/\1/p')
if [ -z "${action}" ]; then
    action="${QUERY_STRING}"
fi

json_header

# CSRF 防护：写操作要求携带 X-Requested-With 自定义头（HTML 表单无法设置自定义头，
# 跨站 fetch 带自定义头会触发 CORS 预检而被拦；官方页面由 api() 统一携带）
if [ "${REQUEST_METHOD}" = "POST" ] && [ -z "${HTTP_X_REQUESTED_WITH}" ]; then
    printf '{"error":"非法请求"}\n'
    exit 0
fi

case "${action}" in
    # ---------------------------
    # 列出订阅（含别名，老格式无 TAB 即别名为空）
    # ---------------------------
    list)
        printf '{"subscriptions":['
        first=true
        if [ -f "${SUB_URLS_FILE}" ]; then
            while IFS= read -r line || [ -n "${line}" ]; do
                [ -z "${line}" ] && continue
                is_comment "${line}" && continue
                # TAB 分隔：别名<TAB>URL[<TAB>off]，无 TAB 即老格式
                alias=$(alias_part "${line}")
                url=$(url_part "${line}")
                state=$(state_part "${line}")
                [ -z "${url}" ] && continue
                if [ "${state}" = "off" ]; then enabled=false; else enabled=true; fi
                if $first; then
                    first=false
                else
                    printf ','
                fi
                # 转义 JSON 特殊字符
                escaped_url=$(echo "${url}" | sed 's/\\/\\\\/g; s/"/\\"/g; s/\x09/\\t/g; s/\x0A/\\n/g; s/\x0D/\\r/g')
                escaped_alias=$(echo "${alias}" | sed 's/\\/\\\\/g; s/"/\\"/g; s/\x09/\\t/g; s/\x0A/\\n/g; s/\x0D/\\r/g')
                printf '{"url":"%s","alias":"%s","enabled":%s}' "${escaped_url}" "${escaped_alias}" "${enabled}"
            done < "${SUB_URLS_FILE}"
        fi
        printf ']}\n'
        ;;

    # ---------------------------
    # 添加订阅（可带别名）
    # ---------------------------
    add)
        body=$(read_body)
        url=$(echo "${body}" | sed -n 's/.*url=\([^&]*\).*/\1/p' | sed 's/+/ /g;s/%/\\x/g')
        url=$(printf "%b" "${url}")
        alias=$(echo "${body}" | sed -n 's/.*alias=\([^&]*\).*/\1/p' | sed 's/+/ /g;s/%/\\x/g')
        alias=$(printf "%b" "${alias}" 2>/dev/null | tr -d '\000-\010\013\014\016-\037\177\t\r\n')
        # 别名长度后端限制（前端 maxlength 只是装饰）。用 wc -c 按字节计：
        # busybox ash 的 ${#var} 在 unicode 构建下按字符数，中文别名会绕过字节上限
        if [ "$(printf '%s' "${alias}" | wc -c)" -gt 128 ]; then
            printf '{"error":"别名过长(上限 128 字节)"}\n'
            exit 0
        fi
        if [ -z "${url}" ]; then
            printf '{"error":"URL 不能为空"}\n'
            exit 0
        fi
        # 基本格式验证
        case "${url}" in
            http://*|https://*) ;;
            *)
                printf '{"error":"URL 必须以 http:// 或 https:// 开头"}\n'
                exit 0
                ;;
        esac
        # 别名不能含 TAB（分隔符），已用 tr 去除；URL 本身不能含 TAB
        case "${url}" in
            *"${TAB}"*)
                printf '{"error":"URL 非法"}\n'
                exit 0
                ;;
        esac
        # 检查重复前先拿锁：读文件与追加之间不能被其他请求插入
        if ! urls_lock; then
            printf '{"error":"操作冲突,请稍后重试"}\n'
            exit 0
        fi
        # 检查重复（按 URL 部分比对，兼容老格式）
        if [ -f "${SUB_URLS_FILE}" ]; then
            while IFS= read -r ex || [ -n "${ex}" ]; do
                if [ "$(url_part "${ex}")" = "${url}" ]; then
                    printf '{"error":"该订阅已存在"}\n'
                    exit 0
                fi
            done < "${SUB_URLS_FILE}"
        fi
        if [ -n "${alias}" ]; then
            printf '%s\t%s\n' "${alias}" "${url}" >> "${SUB_URLS_FILE}"
        else
            echo "${url}" >> "${SUB_URLS_FILE}"
        fi
        printf '{"success":true,"message":"订阅已添加"}\n'
        ;;

    # ---------------------------
    # 删除订阅（按 URL 部分匹配，兼容老格式）
    # ---------------------------
    delete)
        body=$(read_body)
        url=$(echo "${body}" | sed -n 's/.*url=\([^&]*\).*/\1/p' | sed 's/+/ /g;s/%/\\x/g')
        url=$(printf "%b" "${url}")
        if [ -z "${url}" ]; then
            printf '{"error":"URL 不能为空"}\n'
            exit 0
        fi
        if ! urls_lock; then
            printf '{"error":"操作冲突,请稍后重试"}\n'
            exit 0
        fi
        if [ -f "${SUB_URLS_FILE}" ]; then
            tmpf="${SUB_URLS_FILE}.tmp"
            del_urls=""
            del_any=0
            : > "${tmpf}"
            while IFS= read -r ex || [ -n "${ex}" ]; do
                if [ "$(url_part "${ex}")" != "${url}" ]; then
                    printf '%s\n' "${ex}" >> "${tmpf}"
                else
                    # 收集被删除行的 URL（URL 无空白字符，可空格拼接后遍历）
                    del_urls="${del_urls:+${del_urls} }${url}"
                    del_any=1
                fi
            done < "${SUB_URLS_FILE}"
            mv "${tmpf}" "${SUB_URLS_FILE}"
            # 清理对应的 usage 流量存档（ukey 算法与 sub.sh 写入时一致）
            if [ "${del_any}" -eq 1 ]; then
                set -f
                for durl in ${del_urls}; do
                    ukey=$(printf '%s' "${durl}" | md5sum 2>/dev/null | cut -c1-12)
                    [ -n "${ukey}" ] && rm -f "${CONFIG_DIR}/usage/${ukey}.dat"
                done
                set +f
            fi
        fi
        printf '{"success":true,"message":"订阅已删除"}\n'
        ;;

    # ---------------------------
    # 修改别名（alias 为空则清除为无别名行）
    # ---------------------------
    rename)
        body=$(read_body)
        url=$(echo "${body}" | sed -n 's/.*url=\([^&]*\).*/\1/p' | sed 's/+/ /g;s/%/\\x/g')
        url=$(printf "%b" "${url}")
        alias=$(echo "${body}" | sed -n 's/.*alias=\([^&]*\).*/\1/p' | sed 's/+/ /g;s/%/\\x/g')
        alias=$(printf "%b" "${alias}" 2>/dev/null | tr -d '\000-\010\013\014\016-\037\177\t\r\n')
        # 别名长度后端限制（前端 maxlength 只是装饰）。用 wc -c 按字节计：
        # busybox ash 的 ${#var} 在 unicode 构建下按字符数，中文别名会绕过字节上限
        if [ "$(printf '%s' "${alias}" | wc -c)" -gt 128 ]; then
            printf '{"error":"别名过长(上限 128 字节)"}\n'
            exit 0
        fi
        if [ -z "${url}" ]; then
            printf '{"error":"URL 不能为空"}\n'
            exit 0
        fi
        if ! urls_lock; then
            printf '{"error":"操作冲突,请稍后重试"}\n'
            exit 0
        fi
        if [ -f "${SUB_URLS_FILE}" ]; then
            tmpf="${SUB_URLS_FILE}.tmp"
            : > "${tmpf}"
            while IFS= read -r ex || [ -n "${ex}" ]; do
                if [ "$(url_part "${ex}")" = "${url}" ]; then
                    state=$(state_part "${ex}")
                    [ "${state}" = "off" ] || state="on"
                    emit_line "${alias}" "${url}" "${state}" >> "${tmpf}"
                else
                    printf '%s\n' "${ex}" >> "${tmpf}"
                fi
            done < "${SUB_URLS_FILE}"
            mv "${tmpf}" "${SUB_URLS_FILE}"
        fi
        printf '{"success":true,"message":"别名已更新"}\n'
        ;;

    # ---------------------------
    # 启用/停用订阅（不改别名与顺序；停用写第三列 off）
    # ---------------------------
    toggle)
        body=$(read_body)
        url=$(echo "${body}" | sed -n 's/.*url=\([^&]*\).*/\1/p' | sed 's/+/ /g;s/%/\\x/g')
        url=$(printf "%b" "${url}")
        enabled=$(echo "${body}" | sed -n 's/.*enabled=\([^&]*\).*/\1/p')
        case "${enabled}" in
            1|on|true) enabled="on" ;;
            *) enabled="off" ;;
        esac
        if [ -z "${url}" ]; then
            printf '{"error":"URL 不能为空"}\n'
            exit 0
        fi
        if ! urls_lock; then
            printf '{"error":"操作冲突,请稍后重试"}\n'
            exit 0
        fi
        if [ -f "${SUB_URLS_FILE}" ]; then
            tmpf="${SUB_URLS_FILE}.tmp"
            : > "${tmpf}"
            while IFS= read -r ex || [ -n "${ex}" ]; do
                if [ "$(url_part "${ex}")" = "${url}" ]; then
                    emit_line "$(alias_part "${ex}")" "${url}" "${enabled}" >> "${tmpf}"
                else
                    printf '%s\n' "${ex}" >> "${tmpf}"
                fi
            done < "${SUB_URLS_FILE}"
            mv "${tmpf}" "${SUB_URLS_FILE}"
        fi
        printf '{"success":true,"enabled":"%s"}\n' "${enabled}"
        ;;

    # ---------------------------
    # 只启用这一条订阅（Verge 式切换：其他全部停用；配合刷新即整体替换配置）
    # ---------------------------
    solo)
        body=$(read_body)
        url=$(echo "${body}" | sed -n 's/.*url=\([^&]*\).*/\1/p' | sed 's/+/ /g;s/%/\\x/g')
        url=$(printf "%b" "${url}")
        if [ -z "${url}" ]; then
            printf '{"error":"URL 不能为空"}\n'
            exit 0
        fi
        if ! urls_lock; then
            printf '{"error":"操作冲突,请稍后重试"}\n'
            exit 0
        fi
        # 改写文件前先做只读存在性检查：URL 不在列表里直接报错退出，绝不碰文件
        # （否则会先把全部订阅写成 off，然后才发现"订阅不存在"）
        found=0
        if [ -f "${SUB_URLS_FILE}" ]; then
            while IFS= read -r ex || [ -n "${ex}" ]; do
                [ -z "${ex}" ] && continue
                is_comment "${ex}" && continue
                if [ "$(url_part "${ex}")" = "${url}" ]; then
                    found=1
                    break
                fi
            done < "${SUB_URLS_FILE}"
        fi
        if [ "${found}" -eq 0 ]; then
            printf '{"error":"订阅不存在"}\n'
            exit 0
        fi
        if [ -f "${SUB_URLS_FILE}" ]; then
            tmpf="${SUB_URLS_FILE}.tmp"
            : > "${tmpf}"
            while IFS= read -r ex || [ -n "${ex}" ]; do
                # 注释与空行原样保留，不参与切换改写
                if [ -z "${ex}" ] || is_comment "${ex}"; then
                    printf '%s\n' "${ex}" >> "${tmpf}"
                    continue
                fi
                eurl=$(url_part "${ex}")
                if [ "${eurl}" = "${url}" ]; then
                    emit_line "$(alias_part "${ex}")" "${eurl}" "on" >> "${tmpf}"
                else
                    emit_line "$(alias_part "${ex}")" "${eurl}" "off" >> "${tmpf}"
                fi
            done < "${SUB_URLS_FILE}"
            mv "${tmpf}" "${SUB_URLS_FILE}"
        fi
        printf '{"success":true,"message":"已切换，仅启用该订阅"}\n'
        ;;

    # ---------------------------
    # TUN 全局代理开关：与 overlay.yaml 联动（唯一持久源，界面即该文件的图形开关）
    #   开启 = 在 overlay.yaml 写入 tun.enable: true（缺失字段自动补默认值 + 本机 DNS 排除，
    #          不覆盖用户已有自定义；yq 保留注释）
    #   关闭 = 写 tun.enable: false（保留文件里的其他自定义）
    # 切换后立即 PATCH 运行中的 mihomo（9090 面板状态马上一致）并触发刷新兜底。
    # GET 返回 prereq（容器权限）与 runtime（当前运行状态，用于发现 9090 面板的临时改动）。
    # ---------------------------
    tunmode)
        OVERLAY_FILE="${CONFIG_DIR}/overlay.yaml"
        overlay_tun_state() {
            [ -f "${OVERLAY_FILE}" ] || { printf 'none'; return; }
            if command -v yq >/dev/null 2>&1; then
                v=$(yq -r '.tun.enable' "${OVERLAY_FILE}" 2>/dev/null | head -1)
                case "${v}" in
                    true) printf 'on' ;;
                    false) printf 'off' ;;
                    *) printf 'none' ;;
                esac
            else
                printf 'unknown'
            fi
        }
        if [ "${REQUEST_METHOD}" = "POST" ]; then
            body=$(read_body)
            val=$(echo "${body}" | sed -n 's/.*mode=\([^&]*\).*/\1/p')
            case "${val}" in
                on|off) ;;
                *) printf '{"error":"无效模式，可选: on, off"}\n'; exit 0 ;;
            esac
            if ! command -v yq >/dev/null 2>&1; then
                printf '{"error":"容器内缺少 yq，无法编辑 overlay.yaml"}\n'
                exit 0
            fi
            if [ "${val}" = "on" ]; then
                if [ ! -e /dev/net/tun ]; then
                    printf '{"error":"缺少 /dev/net/tun，请在 compose 添加 devices 映射（/dev/net/tun:/dev/net/tun）后重建容器"}\n'
                    exit 0
                fi
                if ! tun_prereq; then
                    printf '{"error":"缺少 NET_ADMIN 权限，请在 compose 添加 cap_add: NET_ADMIN 后重建容器"}\n'
                    exit 0
                fi
            fi
            if [ "${val}" = "off" ] && [ ! -f "${OVERLAY_FILE}" ]; then
                # 没有 overlay 本来就等于关闭，无需创建文件
                printf '{"success":true,"mode":"off","patched":false}\n'
                exit 0
            fi
            [ -f "${OVERLAY_FILE}" ] || : > "${OVERLAY_FILE}"
            # 本机 DNS 排除（host 模式 TUN 接管整机，不排除会导致解析异常）
            tun_ex=""
            if [ "${val}" = "on" ]; then
                for dip in $(grep -iE '^[[:space:]]*nameserver' /etc/resolv.conf 2>/dev/null | awk '{print $2}'); do
                    dip="${dip%%\%*}"
                    case "${dip}" in
                        *:*) tun_ex="${tun_ex:+,}\"${dip}/128\"" ;;
                        *.*) tun_ex="${tun_ex:+,}\"${dip}/32\"" ;;
                    esac
                done
                # 只补缺失字段，不覆盖用户已有自定义（yq 保留注释）
                yq -i '.tun.enable = true' "${OVERLAY_FILE}" 2>/dev/null
                [ "$(yq -r '.tun.stack' "${OVERLAY_FILE}" 2>/dev/null)" = "null" ] && yq -i '.tun.stack = "mixed"' "${OVERLAY_FILE}" 2>/dev/null
                [ "$(yq -r '.tun.mtu' "${OVERLAY_FILE}" 2>/dev/null)" = "null" ] && yq -i '.tun.mtu = 1500' "${OVERLAY_FILE}" 2>/dev/null
                [ "$(yq -r '.tun["auto-route"]' "${OVERLAY_FILE}" 2>/dev/null)" = "null" ] && yq -i '.tun["auto-route"] = true' "${OVERLAY_FILE}" 2>/dev/null
                [ "$(yq -r '.tun["auto-detect-interface"]' "${OVERLAY_FILE}" 2>/dev/null)" = "null" ] && yq -i '.tun["auto-detect-interface"] = true' "${OVERLAY_FILE}" 2>/dev/null
                [ "$(yq -r '.tun["dns-hijack"]' "${OVERLAY_FILE}" 2>/dev/null)" = "null" ] && yq -i '.tun["dns-hijack"] = ["any:53"]' "${OVERLAY_FILE}" 2>/dev/null
                if [ "$(yq -r '.tun["route-exclude-address"]' "${OVERLAY_FILE}" 2>/dev/null)" = "null" ] && [ -n "${tun_ex}" ]; then
                    yq -i ".tun[\"route-exclude-address\"] = [${tun_ex}]" "${OVERLAY_FILE}" 2>/dev/null
                fi
            else
                yq -i '.tun.enable = false' "${OVERLAY_FILE}" 2>/dev/null
            fi
            # 立即生效：PATCH 运行中的 mihomo（两个面板状态马上一致）；失败不阻断，刷新兜底
            api_secret=$(tr -d '[:space:]' < "${CONFIG_DIR}/.secret" 2>/dev/null)
            if [ "${val}" = "on" ]; then
                ex_part=""
                [ -n "${tun_ex}" ] && ex_part=",\"route-exclude-address\":[${tun_ex}]"
                payload=$(printf '{"tun":{"enable":true,"stack":"mixed","mtu":1500,"auto-route":true,"auto-detect-interface":true,"dns-hijack":["any:53"]%s}}' "${ex_part}")
            else
                payload='{"tun":{"enable":false}}'
            fi
            if [ -n "${api_secret}" ]; then
                code=$(api_curl --max-time 5 -o /dev/null -w "%{http_code}" -X PATCH http://127.0.0.1:9090/configs -H "Content-Type: application/json" -H "Authorization: Bearer ${api_secret}" -d "${payload}" 2>/dev/null)
            else
                code=$(api_curl --max-time 5 -o /dev/null -w "%{http_code}" -X PATCH http://127.0.0.1:9090/configs -H "Content-Type: application/json" -d "${payload}" 2>/dev/null)
            fi
            patched=false
            case "${code}" in
                200|204) patched=true ;;
            esac
            printf '{"success":true,"mode":"%s","patched":%s}\n' "${val}" "${patched}"
        else
            case "$(overlay_tun_state)" in
                on) val="on" ;;
                *) val="off" ;;
            esac
            if tun_prereq; then preq=true; else preq=false; fi
            # 当前运行状态（用于发现 9090 面板的临时改动，与预期不一致时页面给出提示）
            runtime=""
            if command -v jq >/dev/null 2>&1; then
                api_secret=$(tr -d '[:space:]' < "${CONFIG_DIR}/.secret" 2>/dev/null)
                if [ -n "${api_secret}" ]; then
                    rt=$(api_curl --max-time 3 -H "Authorization: Bearer ${api_secret}" http://127.0.0.1:9090/configs 2>/dev/null | jq -r '.tun.enable' 2>/dev/null)
                else
                    rt=$(api_curl --max-time 3 http://127.0.0.1:9090/configs 2>/dev/null | jq -r '.tun.enable' 2>/dev/null)
                fi
                case "${rt}" in
                    true) runtime="on" ;;
                    false) runtime="off" ;;
                esac
            fi
            printf '{"mode":"%s","prereq":%s,"runtime":"%s"}\n' "${val}" "${preq}" "${runtime}"
        fi
        ;;

    # ---------------------------
    # 手动刷新
    # ---------------------------
    refresh)
        # 在后台执行刷新，避免 CGI 超时
        nohup "${SUB_SCRIPT}" --now > /dev/null 2>&1 &
        printf '{"success":true,"message":"刷新已触发"}\n'
        ;;

    # ---------------------------
    # 多账号合并方式：merge=同名策略组合并成员（默认）/ isolate=策略组按账号隔离
    # 写入 group_mode.conf，sub.sh 下次刷新时生效
    # ---------------------------
    groupmode)
        if [ "${REQUEST_METHOD}" = "POST" ]; then
            body=$(read_body)
            val=$(echo "${body}" | sed -n 's/.*mode=\([^&]*\).*/\1/p')
            case "${val}" in
                merge|isolate)
                    echo "${val}" > "${GROUP_MODE_FILE}"
                    printf '{"success":true,"mode":"%s"}\n' "${val}"
                    ;;
                *)
                    printf '{"error":"无效模式，可选: merge, isolate"}\n'
                    ;;
            esac
        else
            val=$(head -1 "${GROUP_MODE_FILE}" 2>/dev/null)
            case "${val}" in
                isolate) val="isolate" ;;
                *) val="merge" ;;
            esac
            printf '{"mode":"%s"}\n' "${val}"
        fi
        ;;

    # ---------------------------
    # 获取/设置调度
    # ---------------------------
    schedule)
        if [ "${REQUEST_METHOD}" = "POST" ]; then
            body=$(read_body)
            val=$(echo "${body}" | sed -n 's/.*schedule=\([^&]*\).*/\1/p')
            case "${val}" in
                15min|hourly|daily)
                    echo "${val}" > "${SCHEDULE_FILE}"
                    printf '{"success":true,"schedule":"%s"}\n' "${val}"
                    ;;
                *)
                    printf '{"error":"无效的调度值，可选: 15min, hourly, daily"}\n'
                    ;;
            esac
        else
            val=$(cat "${SCHEDULE_FILE}" 2>/dev/null || echo "daily")
            printf '{"schedule":"%s"}\n' "${val}"
        fi
        ;;

    # ---------------------------
    # 各订阅流量信息（upload/download/total/expire，字节数）
    # 数据由 sub.sh 每次下载时解析 subscription-userinfo 存档
    # ---------------------------
    usage)
        printf '{"usage":['
        first=true
        if [ -f "${SUB_URLS_FILE}" ]; then
            while IFS= read -r line || [ -n "${line}" ]; do
                [ -z "${line}" ] && continue
                is_comment "${line}" && continue
                alias=$(alias_part "${line}")
                url=$(url_part "${line}")
                [ -z "${url}" ] && continue
                ukey=$(printf '%s' "${url}" | md5sum 2>/dev/null | cut -c1-12)
                up=0; down=0; total=0; exp=0
                if [ -n "${ukey}" ] && [ -f "${CONFIG_DIR}/usage/${ukey}.dat" ]; then
                    IFS="$(printf '\t')" read -r up down total exp < "${CONFIG_DIR}/usage/${ukey}.dat" 2>/dev/null
                    up=${up:-0}; down=${down:-0}; total=${total:-0}; exp=${exp:-0}
                fi
                if $first; then
                    first=false
                else
                    printf ','
                fi
                escaped_url=$(echo "${url}" | sed 's/\\/\\\\/g; s/"/\\"/g')
                escaped_alias=$(echo "${alias}" | sed 's/\\/\\\\/g; s/"/\\"/g')
                printf '{"url":"%s","alias":"%s","upload":%d,"download":%d,"total":%d,"expire":%d}' \
                    "${escaped_url}" "${escaped_alias}" "${up}" "${down}" "${total}" "${exp}"
            done < "${SUB_URLS_FILE}"
        fi
        printf ']}\n'
        ;;

    # ---------------------------
    # 获取日志
    # ---------------------------
    logs)
        printf '{"logs":['
        if [ -f "${LOG_FILE}" ]; then
            # 返回最后 100 行
            lines=$(tail -n 100 "${LOG_FILE}" 2>/dev/null)
            first=true
            while IFS= read -r logline || [ -n "${logline}" ]; do
                if [ -z "${logline}" ]; then continue; fi
                if $first; then
                    first=false
                else
                    printf ','
                fi
                escaped=$(echo "${logline}" | sed 's/\\/\\\\/g; s/"/\\"/g; s/\x09/\\t/g; s/\x0A/\\n/g; s/\x0D/\\r/g')
                printf '"%s"' "${escaped}"
            done <<EOF
${lines}
EOF
        fi
        printf ']}\n'
        ;;

    # ---------------------------
    # 获取状态
    # ---------------------------
    status)
        last_run=""
        if [ -f "${LOG_FILE}" ]; then
            last_run=$(sed -n 's/^\[\(.*\)\].*/\1/p' "${LOG_FILE}" | tail -1)
        fi
        schedule=$(cat "${SCHEDULE_FILE}" 2>/dev/null || echo "daily")
        sub_count=0
        if [ -f "${SUB_URLS_FILE}" ]; then
            sub_count=$(awk -F'\t' 'index($0,"\t")==0 && /^#/ {next} /^[[:space:]]*$/ {next} NF>=2 && $NF=="off" {next} {n++} END{print n+0}' "${SUB_URLS_FILE}" 2>/dev/null)
            sub_count=${sub_count:-0}
        fi
        printf '{"last_run":"%s","schedule":"%s","sub_count":%d}\n' "${last_run}" "${schedule}" "${sub_count}"
        ;;

    *)
        printf '{"error":"未知操作: %s"}\n' "${action}"
        ;;
esac
